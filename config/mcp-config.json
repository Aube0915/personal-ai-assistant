{
  "mcpServers": {
    "example-service": {
      "type": "http",
      "url": "https://your-mcp-server.example.com/mcp",
      "headers": {
        "Authorization": "Bearer YOUR_TOKEN_HERE"
      }
    },
    "messaging-bridge": {
      "type": "stdio",
      "command": "node",
      "args": ["path/to/messaging-bridge/index.js"],
      "env": {
        "BOT_TOKEN": "YOUR_BOT_TOKEN",
        "ALLOWED_CHAT_IDS": "comma,separated,ids"
      }
    }
  }
}
